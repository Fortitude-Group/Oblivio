{
  "name": "observatory",
  "private": true,
  "version": "0.1.0",
  "description": "The Observatory — public abandoned-package health observatory",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fairness": "vitest run fairness",
    "lint": "prettier --check \"packages/**/*.{ts,md,json}\"",
    "format": "prettier --write \"packages/**/*.{ts,md,json}\"",
    "dev:stack": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
